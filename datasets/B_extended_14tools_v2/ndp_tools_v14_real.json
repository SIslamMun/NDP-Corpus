    {
      "name": "list_kafka_streams",
      "description": "List Kafka streaming resources on NDP via the resources catalog. Filter by name/format substring. Always sets format='kafka' under the hood.",
      "parameters": [
        {"name": "q",           "type": "string",  "description": "Free-text query across resource fields",                      "required": false},
        {"name": "name",        "type": "string",  "description": "Resource name substring (e.g. 'gnss')",                       "required": false},
        {"name": "description", "type": "string",  "description": "Text to search in resource descriptions",                     "required": false},
        {"name": "limit",       "type": "integer", "description": "Max rows (default 20)",                                       "required": false},
        {"name": "offset",      "type": "integer", "description": "Pagination offset",                                           "required": false},
        {"name": "server",      "type": "string",  "description": "Catalog: 'local' or 'pre_ckan'",                              "required": false}
      ],
      "examples": [
        {
          "instruction": "List Kafka streams on NDP, limit 5.",
          "input": "{\"limit\": 5, \"server\": \"local\"}",
          "output": "{\"resources\": [{\"name\": \"earthscope_kafka_gnss_observations\", \"format\": \"kafka\", \"url\": \"kafka://broker:9196/...\"}], \"count\": 5}"
