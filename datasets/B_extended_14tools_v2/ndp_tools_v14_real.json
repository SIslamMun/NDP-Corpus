      "name": "get_dataset_details",
      "description": "Look up a specific dataset by exact name or id (returns dataset metadata + resources). Uses the catalog search backend (no dedicated /dataset/{id} GET endpoint).",
      "parameters": [
        {"name": "terms",  "type": "array",  "description": "Single-element array containing the dataset name or id", "required": true},
        {"name": "server", "type": "string", "description": "Server: 'local' or 'global'", "required": false}
      ],
      "examples": [
        {
          "instruction": "Show me details for dataset 'clm-full-climate-connectivity-network'.",
          "input": "{\"terms\": [\"clm-full-climate-connectivity-network\"], \"server\": \"global\"}",
          "output": "{\"datasets\": [{\"id\": \"3264e7ee-...\", \"name\": \"clm-full-climate-connectivity-network\", \"title\": \"Full Climate Connectivity Network\", \"owner_org\": \"california-landscape-metrics\", \"resources\": [...], \"extras\": {...}}], \"count\": 1}"
        }
      ]
    },
