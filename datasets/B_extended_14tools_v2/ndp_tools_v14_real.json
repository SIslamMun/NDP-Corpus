    {
      "name": "register_dataset",
      "description": "Create a new general dataset on NDP. Requires bearer auth. POST /dataset.",
      "parameters": [
        {"name": "name",       "type": "string",  "description": "Unique dataset name (lowercase, alphanumeric, underscores/hyphens)",   "required": true},
        {"name": "title",      "type": "string",  "description": "Human-readable dataset title",                                          "required": true},
        {"name": "owner_org",  "type": "string",  "description": "Organization ID that owns this dataset",                                "required": true},
        {"name": "notes",      "type": "string",  "description": "Description or notes about the dataset",                                "required": false},
        {"name": "tags",       "type": "array",   "description": "List of tags for categorization (array of strings)",                    "required": false},
        {"name": "groups",     "type": "array",   "description": "List of groups for the dataset",                                        "required": false},
        {"name": "private",    "type": "boolean", "description": "Whether the dataset is private",                                        "required": false},
        {"name": "license_id", "type": "string",  "description": "License identifier (e.g. 'cc-by')",                                     "required": false},
        {"name": "version",    "type": "string",  "description": "Dataset version string",                                                "required": false},
        {"name": "server",     "type": "string",  "description": "Catalog scope: 'local' or 'pre_ckan'",                                  "required": false}
      ],
      "examples": [
        {
          "instruction": "Register a new public climate dataset 'noaa-temps-2024' for org 'noaa'.",
          "input": "{\"name\": \"noaa-temps-2024\", \"title\": \"NOAA Temperatures 2024\", \"owner_org\": \"noaa\", \"notes\": \"Monthly land surface temp averages\", \"tags\": [\"climate\", \"temperature\"], \"license_id\": \"cc-by\", \"server\": \"local\"}",
          "output": "{\"registration\": {\"id\": \"abc-123\"}, \"name\": \"noaa-temps-2024\", \"server\": \"local\"}"
        }
      ]
    },
    {
      "name": "register_derived_stream",
      "description": "Register a NEW Kafka topic that filters/derives from an existing one (e.g. per-station SNCL filter). Wraps POST /kafka with the `mapping` field recording the source_topic + filter.",
      "parameters": [
        {"name": "dataset_name",  "type": "string",  "description": "Unique dataset name for the derived stream (lowercase, alphanumeric)", "required": true},
        {"name": "dataset_title", "type": "string",  "description": "Dataset title",                                                        "required": true},
        {"name": "owner_org",     "type": "string",  "description": "Owning organization",                                                  "required": true},
        {"name": "kafka_topic",   "type": "string",  "description": "Destination Kafka topic name (new topic for the derived stream)",      "required": true},
        {"name": "kafka_host",    "type": "string",  "description": "Destination broker host",                                              "required": true},
        {"name": "kafka_port",    "type": "integer", "description": "Destination broker port (1-65535)",                                    "required": true},
        {"name": "mapping",       "type": "object",  "description": "Mapping with source_topic and SNCL/other filter info, e.g. {source_topic: 'public.gnss', sncl_filter: 'AGMT.CI.LY.20'}", "required": true},
        {"name": "dataset_description", "type": "string", "description": "Description of the derived stream",                               "required": false},
        {"name": "server",        "type": "string",  "description": "Catalog: 'local' or 'pre_ckan'",                                       "required": false}
      ],
      "examples": [
        {
          "instruction": "From public.gnss.positions create a filtered stream for SNCL 'AGMT.CI.LY.20' on derived.broker:9092 called 'gnss-agmt'.",
          "input": "{\"dataset_name\": \"gnss-agmt\", \"dataset_title\": \"GNSS AGMT only\", \"owner_org\": \"earthscope\", \"kafka_topic\": \"derived.gnss.agmt\", \"kafka_host\": \"derived.broker\", \"kafka_port\": 9092, \"mapping\": {\"source_topic\": \"public.gnss.positions\", \"sncl_filter\": \"AGMT.CI.LY.20\"}, \"server\": \"local\"}",
          "output": "{\"registration\": {\"id\": \"der-ccc\"}, \"server\": \"local\"}"
        }
      ]
    },
